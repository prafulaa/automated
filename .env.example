# ── GitHub App ─────────────────────────────────────────────
# Generate at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Anthropic (Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase (Postgres + Auth) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── pg-boss (job queue) uses the Supabase Postgres ────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/blastradius

# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
