{
  "name": "@blastradius/webhook",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub App webhook handler — receives PR events, enqueues analysis",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blastradius/engine": "workspace:*",
    "@octokit/app": "^15.0.0",
    "@octokit/request-error": "^6.0.0",
    "@octokit/webhooks": "^13.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "pg-boss": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
